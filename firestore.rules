rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can READ their own profile doc, but never write it directly —
    // role/tier/usage are only ever changed by the server (Admin SDK bypasses
    // these rules entirely), so a client can't grant itself admin/paid access
    // by writing to its own doc.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Projects hold customers' photos and are reached ONLY through the server
    // API (/api/projects), which enforces access codes, ownership and rate
    // limits. No direct client access — with the old open rule anyone could
    // list, read or overwrite every saved project straight from the browser.
    match /projects/{projectCode} {
      allow read, write: if false;
    }

    // Portfolio items can be browsed by all. Creating items and liking them go
    // through the server (likes are one-per-account and need sign-in).
    match /portfolio/{portfolioId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
